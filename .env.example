# Copy this file to .env and fill in your own keys. .env is gitignored.
# The app runs fully without either key — every AI feature has a
# deterministic fallback.

# AI advisor layer (core/llm.py): verdict paragraph, prep plan, advisor chat.
# Groq, NOT xAI's Grok — a gsk_... key belongs to api.groq.com.
GROQ_API_KEY=

# Optional: LLM skill extraction, the "Use LLM extraction (slower)" checkbox
# (core/llm_extract.py). Falls back to the keyword extractor when unset.
ANTHROPIC_API_KEY=
